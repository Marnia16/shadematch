# ==============================================================================
# ShadeMatch Backend Environment Configuration (.env.example)
# ==============================================================================

# Server Network Configuration
PORT=8000
HOST=0.0.0.0

# Allowed Frontend Origins for CORS
# Local: http://localhost:5173
# Production (Vercel): https://YOUR-VERCEL-FRONTEND.vercel.app
# Multiple origins can be comma-separated: http://localhost:5173,https://shadematch.vercel.app
FRONTEND_URL=http://localhost:5173

# Optional Machine Learning Model Checkpoint
# If you train a custom scikit-learn model, specify its path here:
# SKIN_TONE_MODEL_PATH=models/skin_tone_rf.joblib
