# ==============================================================================
# ShadeMatch Backend Environment Configuration (.env.example)
# ==============================================================================

# Server Network Configuration
PORT=8000
HOST=0.0.0.0

# Allowed Frontend Origins for CORS
# Local: http://localhost:5173
# Production (Vercel): https://YOUR-VERCEL-FRONTEND.vercel.app
# Multiple origins can be comma-separated: http://localhost:5173,https://shadematch.vercel.app
FRONTEND_URL=http://localhost:5173

# Hosted OOTDiffusion Virtual Try-On Configuration
# Official Hugging Face Space: levihsu/OOTDiffusion (default)
OOTD_GRADIO_SPACE=levihsu/OOTDiffusion

# Optional Hugging Face Token (if you wish to avoid anonymous rate limits or use a private duplicate Space)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Optional: Remote Self-Hosted GPU Worker URL (only if using a custom GPU worker instead of the hosted Space)
# OOTD_WORKER_URL=https://your-colab-tunnel.ngrok-free.app

# Optional Machine Learning Model Checkpoint
# If you train a custom scikit-learn model, specify its path here:
# SKIN_TONE_MODEL_PATH=models/skin_tone_rf.joblib
