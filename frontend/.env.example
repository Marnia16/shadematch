# ==============================================================================
# ShadeMatch Frontend Environment Configuration (.env.example)
# ==============================================================================

# Backend API Base URL (FastAPI)
# Local Development: http://localhost:8000
# Production (Render): https://shadematch-backend-rqvn.onrender.com
VITE_API_URL=https://shadematch-backend-rqvn.onrender.com

# Firebase Client Configuration (Optional)
# ShadeMatch features a seamless built-in local persistence fallback.
# If you wish to connect a live Google Firebase project, provide your client keys below.
# (Note: Client keys are public web identifiers; never place private service-account credentials here)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
